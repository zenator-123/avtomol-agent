    "repository": "zenator-123/avtomol-agent",
    "githubTokenEnv": "GITHUB_TOKEN",
    "autoRetryEnv": "NIKOLAY_AUTO_RETRY",
    "maxRetriesPerRun": 1,
    "workers": [
      {
        "name": "AvtoMol синхронизация",
        "workflow": "daily-vehicle-sync.yml",
        "critical": true,
        "autoRetry": false
      },
      {
        "name": "Цени според пазара",
        "workflow": "market-price-sync.yml",
        "critical": true,
        "autoRetry": false
      },
      {
        "name": "OLX цени и позиции",
        "workflow": "olx-update-prices.yml",
        "critical": true,
        "autoRetry": false
      },
      {
        "name": "Защитени автомобили",
        "workflow": "protected-vehicle-sync.yml",
        "critical": true,
        "autoRetry": false
      },
      {
        "name": "OLX отчет",
        "workflow": "olx-export-adverts.yml",
        "critical": false,
        "autoRetry": true
      },
      {
        "name": "НИКОЛАЙ реклама и SEO",
        "workflow": "nikolay-growth-agent.yml",
        "critical": true,
        "autoRetry": false
      }
    ]
  },
